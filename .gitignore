# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 템플릿은 커밋 (실제 값 없음)
!.env.example

# 원본 영상은 커밋하지 않는다 (523MB) — ~/Documents/hgrs-assets/raw 에 보관

# Drive 원본 덤프는 레포에 두지 않는다 — ~/Documents/hgrs-assets/ 에 보관
drive-download-*

# ── 원본 영상·캡처는 레포에 넣지 않는다 ────────────────────────────
# 배포에 쓰이는 건 public/portfolio/clips 의 720p 인코딩본뿐이다.
# 원본(편당 10~190MB, 합 1.6GB)이 들어가면 클론·빌드가 통째로 느려지고
# Vercel 빌드 대역폭도 그만큼 먹는다.
/*.mp4
/*.mov
/영상모음1/
/영상모음2, 유튜브링크/
/스크린샷*.png

# 로고 정규화 전 원본 백업 — 재생성 스크립트 입력일 뿐 배포에 필요 없다
public/logos/_raw/

# 업무 문서(기획표·링크목록 등)는 레포에 두지 않는다
/*.docx
/*.xlsx
/*.pdf
/*.pptx
