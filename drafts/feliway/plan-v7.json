  "lines": [
    {
      "at": 0,
      "until": 1.56,
      "text": "이사하고 3일째 밥을",
      "hi": true
    },
    {
      "at": 1.56,
      "until": 3.84,
      "text": "안먹더라구요 소리만 나면"
    },
    {
      "at": 3.84,
      "until": 5.46,
      "text": "옷장으로 숨고 좋아하던"
    },
    {
      "at": 5.46,
      "until": 7.8,
      "text": "숨숨집도 안들어가요 제가"
    },
    {
      "at": 7.8,
      "until": 9.5,
      "text": "데려온건데 제 탓같아서"
    },
    {
      "at": 9.5,
      "until": 11,
      "text": "알게된게 고양이 폐로몬"
    },
    {
      "at": 11,
      "until": 13.12,
      "text": "디퓨서 에요 안심할때 얼굴"
    },
    {
      "at": 13.12,
      "until": 13.72,
      "text": "비벼남기는"
    },
    {
      "at": 13.72,
      "until": 15.4,
      "text": "표속이래요 긁는거"
    },
    {
      "at": 15.4,
      "until": 16.84,
      "text": "오금실수"
    },
    {
      "at": 16.84,
      "until": 18.5,
      "text": "숨는거 환경바뀔"
    },
    {
      "at": 18.5,
      "until": 19.7,
      "text": "때 쓰는거에요 약도"
    },
    {
      "at": 19.7,
      "until": 21.46,
      "text": "먹히는것도 아니고 고양이"
    },
    {
      "at": 21.46,
      "until": 23.56,
      "text": "만 느껴서 사람은 몰라요"
    },
    {
      "at": 23.56,
      "until": 24.22,
      "text": "꽂으면 끝"
    },
    {
      "at": 24.22,
      "until": 25.96,
