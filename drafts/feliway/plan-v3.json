  "_자막": "나레이션 한 문장을 2~3장으로 쪼갠다. 한 줄 10자 안팎이라야 레퍼런스만큼 커진다",
  "lines": [
    {
      "at": 0.0,
      "until": 1.15,
      "text": "이사하고 3일째인데"
    },
    {
      "at": 1.15,
      "until": 2.5,
      "text": "밥을 아예 안 먹어요"
    },
    {
      "at": 2.62,
      "until": 3.85,
      "text": "소리만 나면 후다닥"
    },
    {
      "at": 3.85,
      "until": 5.19,
      "text": "옷장으로 숨어버리고"
    },
    {
      "at": 5.31,
      "until": 6.6,
      "text": "좋아하던 숨숨집도"
    },
    {
      "at": 6.6,
      "until": 7.85,
      "text": "이제 안 들어가요"
    },
    {
      "at": 7.97,
      "until": 9.45,
      "text": "제가 데려온 건데"
    },
    {
      "at": 9.45,
      "until": 10.99,
      "text": "다 제 탓 같았어요"
    },
    {
      "at": 11.11,
      "until": 12.45,
      "text": "그러다 알게 된 게"
    },
    {
      "at": 12.45,
      "until": 13.85,
      "text": "고양이 페로몬 디퓨저",
      "hi": true
    },
    {
      "at": 13.97,
      "until": 15.25,
      "text": "고양이가 안심할 때"
    },
    {
      "at": 15.25,
      "until": 16.55,
      "text": "얼굴 비벼 남기는"
    },
    {
      "at": 16.55,
      "until": 17.83,
      "text": "바로 그 표식이래요"
    },
    {
      "at": 17.95,
      "until": 19.1,
      "text": "진정제가 아니에요",
      "hi": true
    },
    {
      "at": 19.1,
      "until": 20.28,
      "text": "먹이는 것도 아니고"
    },
    {
      "at": 20.4,
      "until": 21.6,
      "text": "리필 끼우기만 하면"
    },
    {
      "at": 21.6,
      "until": 23.02,
      "text": "콘센트에 꽂으면 끝"
    },
    {
      "at": 23.14,
      "until": 24.65,
      "text": "웅크리고 자던 애가"
    },
    {
      "at": 24.65,
      "until": 26.62,
      "text": "대자로 뻗어서 자요",
      "hi": true
    },
    {
      "at": 26.74,
      "until": 28.2,
      "text": "천 마리 넘게 실험"
    },
    {
      "at": 28.2,
      "until": 30.27,
      "text": "7일째부터 달라져요",
      "hi": true
    },
    {
      "at": 30.39,
      "until": 32.0,
      "text": "하나로 22평 30일"
    },
    {
      "at": 32.0,
      "until": 33.77,
      "text": "하루 1,500원꼴",
      "hi": true
    },
    {
      "at": 33.89,
      "until": 35.4,
      "text": "이사·합사 앞두고 있다면"
    },
    {
      "at": 35.4,
      "until": 36.91,
      "text": "지금 미리 꽂아두세요"
