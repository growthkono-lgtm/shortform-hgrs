# ─────────────────────────────────────────────────────────
# HGRS 숏폼 부스팅 — 환경변수 템플릿
# 실제 값은 .env.local 에 넣습니다 (git에 올라가지 않음)
# ─────────────────────────────────────────────────────────

# ── Supabase ── 필수. 지금 단계에서 필요
# Supabase 대시보드 → 프로젝트 선택 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CLI로 마이그레이션 밀 때만 사용 (선택)
SUPABASE_PROJECT_REF=

# ── 사이트 URL ── 로컬 개발 중엔 localhost 그대로
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────
# 아래는 해당 단계에 갈 때 채웁니다. 지금은 비워두세요.
# ─────────────────────────────────────────────────────────

# ── 토스페이먼츠 (W1 후반) ──
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 채널톡 (W1) ──
NEXT_PUBLIC_CHANNEL_TALK_PLUGIN_KEY=

# ── 그로스 AI (W2) ──
ANTHROPIC_API_KEY=

# ── 트랜잭션 메일 (W2) ──
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
ADMIN_EMAIL=

# ── Google Drive 서비스 계정 (W2~3) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# ── 인스타 데이터 수집 벤더 (W2) ──
INSTAGRAM_SCRAPER_API_KEY=
