# ─────────────────────────────────────────────────────────
# HGRS 숏폼 부스팅 — 환경변수 템플릿
# 실제 값은 .env.local 에 넣습니다 (git에 올라가지 않음)
# ─────────────────────────────────────────────────────────

# ── Supabase ── 필수. 지금 단계에서 필요
# Supabase 대시보드 → 프로젝트 선택 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CLI로 마이그레이션 밀 때만 사용 (선택)
SUPABASE_PROJECT_REF=

# ── 사이트 URL ── 로컬 개발 중엔 localhost 그대로
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 작업자 대시보드 호스트 ── 쉼표로 여러 개
# 이 호스트로 들어오면 /work/** 외에는 전부 404 가 된다(proxy.ts).
# 우리 도메인(hgrs.io) 계열을 절대 넣지 말 것 — 루트를 쳐 보면 회사가 드러난다.
# 비워 두면 분리가 꺼지고 localhost:3000/work 로 개발할 수 있다.
WORK_HOSTS=

# ─────────────────────────────────────────────────────────
# 아래는 해당 단계에 갈 때 채웁니다. 지금은 비워두세요.
# ─────────────────────────────────────────────────────────

# ── 토스페이먼츠 (W1 후반) ──
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 채널톡 (W1) ──
NEXT_PUBLIC_CHANNEL_TALK_PLUGIN_KEY=

# ── 그로스 AI (W2) ──
ANTHROPIC_API_KEY=

# ── 트랜잭션 메일 (W2) ──
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
ADMIN_EMAIL=

# ── Google Drive 서비스 계정 (W2~3) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# ── 인플루언서 채널 지표 수집 (Apify) ──
# 어드민에서 후보 채널 링크만 넣으면 팔로워·게시물수·평균 조회/좋아요/댓글을 자동 수집한다.
# apify.com → Settings → Integrations → Personal API token
# 쓰는 액터: apify~instagram-profile-scraper / clockworks~tiktok-scraper / streamers~youtube-scraper
APIFY_TOKEN=

# ── GitHub ── 레포 생성·푸시용 Personal Access Token (scope: repo)
GITHUB_TOKEN=

# ── 구글 드라이브 직접 업로드 (작업자 대시보드) ──
# 작업자가 완성본을 끌어다 놓으면 지정 폴더로 바로 올라간다.
# ⚠️ 서비스 계정은 개인 드라이브에 파일을 소유할 수 없다(저장용량 0).
#    반드시 **공유 드라이브(Shared Drive)** 안의 폴더를 쓰고, 서비스 계정을 멤버로 추가할 것.
# 값이 비어 있으면 업로드 박스 대신 링크 붙여넣기로 폴백한다.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# 프로젝트별 폴더를 만들 공유 드라이브 ID (URL 의 /drive/folders/ 뒤 값)
GOOGLE_SHARED_DRIVE_ID=
# 파일 "업로드한 사람"을 회사 계정으로 찍고 싶을 때. 관리 콘솔에서 도메인 전체 위임 등록 필요
GOOGLE_IMPERSONATE_EMAIL=

# ── 검색엔진 소유확인 ────────────────────────────────────────────────
# Search Console / 네이버 서치어드바이저가 주는 메타 태그의 content 값만 넣는다.
# 태그 전체가 아니라 따옴표 안의 문자열만. 비워 두면 태그가 안 나간다
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# fal.ai — Seedance 2.0 영상 생성. 발급: https://fal.ai/dashboard/keys
# sora-2 API 가 2026-09-24 삭제되어 이쪽으로 이관한다
FAL_KEY=
